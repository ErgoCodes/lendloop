# Copy to n8n/.env (git-ignored). These are read by n8n as $env.* — they are
# NOT stored in the exported workflow JSON.

# Encrypts credentials stored in n8n's database. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# Base URL of Convex HTTP actions (note: .convex.site, not .convex.cloud).
#   Cloud deployment:  https://<deployment>.convex.site
#   Local backend:     http://host.docker.internal:3211
CONVEX_SITE_URL=https://<deployment>.convex.site

# Shared secrets: must match the values set in Convex with `pnpm convex env set`.
# Generate each with: openssl rand -hex 32
CONVEX_TO_N8N_SECRET=change-me   # Convex signs loan events, n8n verifies
N8N_TO_CONVEX_SECRET=change-me   # n8n signs calls to Convex, Convex verifies

# Sender / ops addresses used in emails (Mailpit accepts anything locally).
LENDLOOP_FROM_EMAIL=LendLoop <no-reply@lendloop.local>
LENDLOOP_OPS_EMAIL=ops@lendloop.local
LENDLOOP_APP_URL=http://localhost:3000
