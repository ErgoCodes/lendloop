# ---- Next.js (.env.local) ----
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- Convex (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-instance>.clerk.accounts.dev
# N8N_WEBHOOK_URL=http://<n8n-host>/webhook/lendloop-requests
# N8N_TO_CONVEX_HMAC_SECRET=<random 32+ bytes>
# CONVEX_TO_N8N_HMAC_SECRET=<random 32+ bytes>

# ---- n8n (docker compose reads this from n8n/.env) ----
# N8N_ENCRYPTION_KEY=<random>
# CONVEX_SITE_URL=https://<your-deployment>.convex.site
