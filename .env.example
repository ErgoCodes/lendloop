# ---- Next.js (.env.local) ----
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- Convex (set with `pnpm convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-instance>.clerk.accounts.dev
# ROOT_ADMIN_EMAIL=you@example.com   # bootstrap admin (must be verified in Clerk)
# N8N_LOAN_EVENTS_WEBHOOK_URL=http://<n8n-host>/webhook/lendloop-loan-events
# CONVEX_TO_N8N_SECRET=<openssl rand -hex 32>   # Convex signs loan events, n8n verifies
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32>   # n8n signs calls to Convex, Convex verifies

# ---- n8n (docker compose reads this from n8n/.env) ----
# N8N_ENCRYPTION_KEY=<random>
# CONVEX_SITE_URL=https://<your-deployment>.convex.site
